# Copy to .env and adjust. docker compose reads .env automatically.

# Application database and the separate test database (libpq URLs; host "db" inside Compose).
DATABASE_URL=postgresql://median:median@db:5432/median
TEST_DATABASE_URL=postgresql://median:median@db:5432/median_test

# Root of all stored media and state (staging, archive, thumbs, trash, ...).
DATA_DIR=/data
# Time zone used to display times (stored in UTC).
APP_TIMEZONE=Asia/Seoul
# Login password for the UI. Empty: no login (a banner warns about it). Set it before the
# service is reachable from anywhere but your own LAN.
APP_PASSWORD=
# Signs the session cookies (any long random string, e.g. `openssl rand -hex 32`). Empty: a
# random key is created once in DATA_DIR/secrets/session_key.
SECRET_KEY=
# Max Hamming distance for similar images (pHash, 64 bits).
IMAGE_PHASH_THRESHOLD=6
# Max Hamming distance per video frame pair.
VIDEO_FRAME_THRESHOLD=8
# Days before discarded originals are purged from trash.
TRASH_RETENTION_DAYS=7
# Defaults for settings that /settings can override (stored in the database):
# review queue order (oldest|newest), database dumps to keep, and when to upgrade the
# crawler tools (cron in APP_TIMEZONE). The thresholds, retention and time zone above too.
REVIEW_ORDER=oldest
BACKUP_RETENTION=14
TOOLS_UPDATE_SCHEDULE=0 5 * * 1

# PostgreSQL container settings (must match the URLs above).
POSTGRES_USER=median
POSTGRES_PASSWORD=median
POSTGRES_DB=median
POSTGRES_TEST_DB=median_test
# Host port for the web UI.
WEB_PORT=8000
